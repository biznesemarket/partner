# Образец .env для docker compose (deploy/). Скопировать в .env и заполнить.
# Файл .env НЕ коммитится в git: здесь только секреты (installation.md §2).

# --- PostgreSQL (обязательно) ---
POSTGRES_PASSWORD=change-me-strong

# --- Сервер (обязательно) ---
# Bearer-токен API; пустое значение допустимо только в demo (routes.py §auth)
PARTNER_API_TOKEN=change-me-strong
# v1.2 tenant/RBAC: токены, привязанные к организациям (JSON token → tenant):
#   {"token-fonii":"fonii","token-other":"other"}
# Если задано, токены из карты видны только своему tenant; PARTNER_API_TOKEN
# остается глобальным административным токеном.
PARTNER_TENANT_TOKENS=

# --- Необязательные ---
# Привязка порта сервера; наружу — через reverse-proxy с TLS
PARTNER_BIND=127.0.0.1:8080
# Часовой пояс закрытия дня по умолчанию (ADR-0017; переопределяется политикой проекта)
PARTNER_CLOSE_TZ=Europe/Moscow
# Грейс приема опоздавших событий, часов
PARTNER_GRACE_HOURS=24
# Окно спора дня, дней
PARTNER_DISPUTE_DAYS=3

# --- Каналы доставки дайджестов (M6.3) ---
PARTNER_WEBHOOK_URL=
PARTNER_SMTP_HOST=
PARTNER_SMTP_PORT=587
PARTNER_SMTP_FROM=partner@example.local
PARTNER_SMTP_TO=

# --- Бэкапы (M8.3) ---
# Время ежедневного дампа
PARTNER_BACKUP_AT=02:00
# Хранение дампов, дней (ADR-0020)
PARTNER_BACKUP_KEEP_DAYS=14

# --- Лицензирование подписки (M9.1, ADR-0018) ---
# Ключ и секрет выдаются при оформлении подписки; REQUIRED=1 для боевых установок
PARTNER_LICENSE_KEY=
PARTNER_LICENSE_SECRET=
PARTNER_LICENSE_REQUIRED=1
PARTNER_LICENSE_GRACE_DAYS=14
# Подпись устройств heartbeat (threat-model §4): 1 — неподписанные батчи отклоняются
PARTNER_REQUIRE_DEVICE_SIGN=0
# Коннекторы GitHub/Forgejo/Gitea (v1.1): секрет вебхука; пусто — вебхуки 503.
# Общий секрет для всех проектов:
PARTNER_CONNECTOR_SECRET=
# Или карта project_id → секрет (JSON):
PARTNER_CONNECTOR_SECRETS=

# --- Обновления (M8.2) ---
# Предыдущий тег образа для rollback.sh
PARTNER_IMAGE_PREV=partner:latest
