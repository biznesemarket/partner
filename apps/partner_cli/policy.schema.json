{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "partner/policy/schema-1.0",
  "title": "Политика проекта «Партнер» (POLICY-SCHEMA 1.0)",
  "type": "object",
  "required": ["meta", "project", "economics", "time", "day", "versions"],
  "additionalProperties": false,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["schema_version", "policy_version", "tenant_id", "project_id", "approved_by", "effective_from"],
      "properties": {
        "schema_version": {"type": "string"},
        "policy_version": {"type": "integer", "minimum": 1},
        "tenant_id": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "approved_by": {"type": "string", "minLength": 1},
        "effective_from": {"type": "string"}
      }
    },
    "project": {
      "type": "object",
      "required": ["name", "forge", "repo", "timezone", "default_branch"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "forge": {"enum": ["github", "forgejo", "gitea"]},
        "repo": {"type": "string", "minLength": 1},
        "timezone": {"type": "string", "minLength": 1},
        "default_branch": {"type": "string", "minLength": 1}
      }
    },
    "economics": {
      "type": "object",
      "required": ["valuation_rub", "rate_rub_per_hour", "currency", "pool_pct", "founder_floor_pct"],
      "properties": {
        "valuation_rub": {"type": "integer", "minimum": 1},
        "rate_rub_per_hour": {"type": "integer", "minimum": 1},
        "currency": {"type": "string"},
        "pool_pct": {"type": "number", "minimum": 1, "maximum": 99},
        "founder_floor_pct": {"type": "number", "minimum": 0, "maximum": 99},
        "cash_share_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "cash_payment_schedule": {"enum": ["daily", "weekly", "monthly"]},
        "revaluation_notice_days": {"type": "integer", "minimum": 0},
        "pool_info_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "pool_warn_pct": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "time": {
      "type": "object",
      "required": ["mode", "k_supervised", "k_autonomous", "daily_cap_hours", "autonomous_paid_cap_hours"],
      "properties": {
        "mode": {"enum": ["time_based", "fixed_price", "hybrid"]},
        "k_supervised": {"type": "number", "minimum": 0, "maximum": 2},
        "k_autonomous": {"type": "number", "minimum": 0, "maximum": 1},
        "daily_cap_hours": {"type": "number", "minimum": 1, "maximum": 24},
        "autonomous_paid_cap_hours": {"type": "number", "minimum": 0},
        "heartbeat_interval_sec": {"type": "integer", "minimum": 5},
        "active_window_sec": {"type": "integer", "minimum": 30},
        "presence_window_sec": {"type": "integer", "minimum": 60},
        "idle_timeout_sec": {"type": "integer", "minimum": 60},
        "max_clock_skew_sec": {"type": "integer", "minimum": 10},
        "manual_only_policy": {"enum": ["track_only", "bill", "ignore"]},
        "require_task_link": {"type": "boolean"}
      }
    },
    "day": {
      "type": "object",
      "properties": {
        "close_at": {"type": "string"},
        "late_grace_hours": {"type": "number", "minimum": 1},
        "dispute_window_days": {"type": "integer", "minimum": 1},
        "digest_hour": {"type": "integer", "minimum": 0, "maximum": 23},
        "digest_channels": {"type": "array", "items": {"type": "string"}}
      }
    },
    "vesting": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "months": {"type": "integer", "minimum": 1},
        "cliff_months": {"type": "integer", "minimum": 0},
        "active_month_rule": {"enum": ["paid_hours", "amount"]},
        "active_month_min_paid_hours": {"type": "number", "minimum": 1},
        "active_month_min_amount_rub": {"type": "integer", "minimum": 1},
        "cash_vesting": {"type": "boolean"},
        "acceleration": {"type": "string"},
        "control_change_threshold_pct": {"type": "number", "minimum": 1, "maximum": 100},
        "inactive_pause_months": {"type": "integer", "minimum": 0}
      }
    },
    "versions": {
      "type": "object",
      "required": ["rate", "valuation"],
      "properties": {
        "rate": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/versionEntry"}},
        "valuation": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/versionEntry"}}
      }
    },
    "identity": {
      "type": "object",
      "properties": {
        "max_accounts_per_forge": {"type": "integer", "minimum": 1},
        "require_proof": {"type": "boolean"},
        "exception_approvers": {"type": "array", "items": {"type": "string"}},
        "exception_min_reason_len": {"type": "integer", "minimum": 1},
        "wip_scope": {"enum": ["person", "device", "project"]}
      }
    },
    "quality": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "k_default": {"type": "number", "minimum": 0.1, "maximum": 2},
        "k_min": {"type": "number", "minimum": 0, "maximum": 2},
        "k_max": {"type": "number", "minimum": 0, "maximum": 2},
        "requires_reason": {"type": "boolean"}
      }
    },
    "storage": {
      "type": "object",
      "properties": {
        "raw_events_retention_days": {"type": "integer", "minimum": 7},
        "git_anchor": {"enum": ["daily", "monthly"]},
        "anchor_repo_path": {"type": "string"}
      }
    },
    "legal": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "jurisdiction": {"type": ["string", "null"]},
        "entity_name": {"type": ["string", "null"]},
        "entity_ids": {"type": ["object", "null"]},
        "contract_template_ref": {"type": ["string", "null"]},
        "newco_target_months": {"type": ["integer", "null"]},
        "pd_consent_required": {"type": "boolean"}
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "require_signed_events": {"type": "boolean"},
        "no_output_flag_hours": {"type": "number", "minimum": 1},
        "night_autonomous_flag_hours": {"type": "number", "minimum": 1},
        "synthetic_input_detection": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "versionEntry": {
      "type": "object",
      "required": ["effective_from", "value", "reason", "approved_by"],
      "properties": {
        "effective_from": {"type": "string"},
        "value": {"type": "number", "exclusiveMinimum": 0},
        "reason": {"type": "string", "minLength": 5},
        "approved_by": {"type": "string", "minLength": 1},
        "adr_ref": {"type": "string"}
      }
    }
  }
}
